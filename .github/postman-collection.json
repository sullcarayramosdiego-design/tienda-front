            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecommerce3d.com\",\n  \"password\": \"Admin123!\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"Sistema\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
